
@page "/"

<PageTitle>Home</PageTitle>

<h1>Taxa beregner</h1>

<div>
    <label for="km">Distance (km):</label>
    <input id="km" type="number" step="0.1" @bind="KM" />
</div>

<div>
    <label for="when">Hvornår?</label>
    <input id="when" type="text" @bind="When" />
</div>

<button @onclick="Calculate">Beregn pris</button>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <p>@ErrorMessage</p>
}

@if (!string.IsNullOrEmpty(Result))
{
    <p>@Result</p>
}

<div class="map"></div>
